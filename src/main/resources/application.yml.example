# application.yml.example
# ─────────────────────────────────────────────────────────────────────────────
# Reference for all environment variables needed to run this app in production.
# For local development: copy this as application-local.yml and fill in values.
# For Render/Docker: set these as Environment Variables in your Render dashboard.
# ─────────────────────────────────────────────────────────────────────────────

spring:
  datasource:
    url: ${DB_URL}
    # Example: jdbc:mysql://your-db-host:3306/mocktestapp?useSSL=true&serverTimezone=UTC
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: ${GOOGLE_CLIENT_ID}
            client-secret: ${GOOGLE_CLIENT_SECRET}

server:
  port: ${PORT:8080}

app:
  jwt:
    secret: ${JWT_SECRET}          # Required — generate with: openssl rand -hex 64
    expiration-ms: ${JWT_EXPIRATION_MS:86400000}
    refresh-expiration-ms: ${JWT_REFRESH_EXPIRATION_MS:604800000}

  frontend-url: ${FRONTEND_URL}    # e.g. https://your-app.vercel.app
  allowed-origins: ${ALLOWED_ORIGINS}  # Comma-separated, e.g. https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Required Environment Variables Summary:
#
#   DB_URL              — Full JDBC URL to your MySQL database
#   DB_USERNAME         — Database user
#   DB_PASSWORD         — Database password
#   GOOGLE_CLIENT_ID    — From Google Cloud Console → OAuth 2.0 credentials
#   GOOGLE_CLIENT_SECRET— From Google Cloud Console → OAuth 2.0 credentials
#   JWT_SECRET          — Random secret, min 32 chars (auto-generated by Render)
#   FRONTEND_URL        — Your deployed frontend URL (for OAuth redirect)
#   ALLOWED_ORIGINS     — CORS allowed origins (usually same as FRONTEND_URL)
# ─────────────────────────────────────────────────────────────────────────────
